{
  "name": "qvac-babel-room",
  "version": "0.1.0",
  "description": "Serverless live-caption room: everyone speaks their own language, every peer reads everyone in theirs. Speech-to-text and translation run on-device with Tether QVAC; peers connect over Hyperswarm.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "babel-room": "./bin/babel-room.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "qvac",
    "tether",
    "translation",
    "captions",
    "speech-to-text",
    "hyperswarm",
    "p2p",
    "accessibility",
    "local-ai"
  ],
  "author": "lopeselio",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lopeselio/qvac-babel-room.git"
  },
  "dependencies": {
    "@qvac/sdk": "^0.23.0",
    "hyperswarm": "^4.17.2"
  },
  "devDependencies": {
    "hyperdht": "^6.36.0"
  }
}
