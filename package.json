{
  "name": "qvac-babel-room",
  "version": "0.1.0",
  "description": "Serverless live-caption room: everyone speaks their own language, every peer reads everyone in theirs. Speech-to-text and translation run on-device with Tether QVAC; peers connect over Hyperswarm.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "babel-room": "bin/babel-room.js"
  },
  "files": [
    "bin",
    "src",
    "ui/dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/babel-room.js ui",
    "test": "node --test --test-timeout=90000",
    "build:ui": "npm --prefix ui ci && npm --prefix ui run build",
    "dev:ui": "npm --prefix ui run dev",
    "prepack": "npm run build:ui"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "qvac",
    "tether",
    "translation",
    "captions",
    "speech-to-text",
    "hyperswarm",
    "p2p",
    "accessibility",
    "local-ai"
  ],
  "author": "lopeselio",
  "license": "Apache-2.0",
  "homepage": "https://github.com/lopeselio/qvac-babel-room#readme",
  "bugs": {
    "url": "https://github.com/lopeselio/qvac-babel-room/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lopeselio/qvac-babel-room.git"
  },
  "dependencies": {
    "@qvac/sdk": "^0.23.0",
    "b4a": "^1.9.0",
    "bare-crypto": "^1.15.4",
    "bare-events": "^2.9.2",
    "hyperswarm": "^4.17.2"
  },
  "devDependencies": {
    "hyperdht": "^6.36.0"
  },
  "imports": {
    "#crypto": {
      "bare": "bare-crypto",
      "default": "crypto"
    },
    "#events": {
      "bare": "bare-events",
      "default": "events"
    }
  }
}
