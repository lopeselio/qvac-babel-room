{
  "name": "babel-room-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "worklet": "bare-pack --base .. --host ios-arm64 --host ios-arm64-simulator --host ios-x64-simulator --host android-arm64 --linked --imports worklet/bare-imports.json --out worklet/room.bundle.js worklet/room.mjs",
    "prebuild": "npm run worklet && expo prebuild",
    "start": "expo start",
    "ios": "npm run worklet && expo run:ios",
    "ios:device": "npm run worklet && expo run:ios --device",
    "android:device": "npm run worklet && expo run:android --device",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --test test/*.test.ts",
    "android": "expo run:android"
  },
  "dependencies": {
    "@qvac/asr-ggml-android-arm64": "0.11.2",
    "@qvac/asr-ggml-ios": "0.11.2",
    "@qvac/fabric-android-arm64": "0.25.0",
    "@qvac/fabric-ios": "0.25.0",
    "@qvac/sdk": "^0.23.0",
    "bare-rpc": "^1.5.0",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bare-kit": "0.16.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "bare-link": "^4.2.0",
    "bare-pack": "^3.0.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  }
}
